# Credenciais do portal Inlog (não compartilhe este arquivo)
INLOG_USER=seu_usuario
INLOG_PASSWORD=sua_senha

# Página de login do rastreamento
INLOG_LOGIN_URL=https://consorcioaparecida.inlog.com.br/Rastreamento/Apresentacao/Autenticador/Account/Login?returnUrl=%2FRastreamento%2FApresentacao%2FAutenticador%2F

# URL após o login (home do rastreamento)
INLOG_BASE_URL=https://consorcioaparecida.inlog.com.br/Rastreamento/Apresentacao/

# Filtro dos caminhões de coleta domiciliar (texto parcial, case-insensitive)
FILTRO_SERVICO=coleta domiciliar

# Prefixo da frota de compactadores. CCL = todos (CCL-001, CCL-002, ...)
FILTRO_VEICULOS=CCL

# Data da rota no formato YYYY-MM-DD. Vazio = hoje
DATA_ROTA=

# Ciclo do dia. DATA_FIM vazio = mesma DATA_ROTA, ou o dia seguinte se a hora final for menor.
HORA_INICIO=06:00
HORA_FIM=05:59
DATA_FIM=

# true = sem janela do navegador | false = você acompanha o robô na tela
HEADLESS=true

# Tempo máximo de espera por tela/API (ms)
TIMEOUT_MS=45000

# Atraso entre ações do Playwright (ms). Útil para depurar com HEADLESS=false
SLOW_MO_MS=0

# Porta do painel web
PORTA=5889

# Argos Monitoramento (opcional — compactadores também cadastrados lá)
ARGOS_USER=
ARGOS_PASSWORD=
ARGOS_LOGIN_URL=https://sso.argosmonitoramento.com.br/
ARGOS_BASE_URL=https://app.argosmonitoramento.com.br/
# Placas dos compactadores no Argos (sem hífen também vale)
ARGOS_VEICULOS=RBK7H47,RBM2G21,RBL0C01

# Segtrack / Fulltrack (compactadores de Aparecida)
SEGTRACK_USER=
SEGTRACK_PASSWORD=
SEGTRACK_LOGIN_URL=https://segtrack-seguranca-eletronica-e-servicos-inteligentes.fulltrackapp.com/
SEGTRACK_HOME_URL=https://segtrack-seguranca-eletronica-e-servicos-inteligentes.fulltrackapp.com/dashboard_controller
SEGTRACK_MAPA_URL=https://segtrack-seguranca-eletronica-e-servicos-inteligentes.fulltrackapp.com/mapaGeral_v3/#/
# Placas sem hífen. Vazio = compactadores RSD em Aparecida (VW 17.260 e 18.260).
SEGTRACK_VEICULOS=

# API oficial Fulltrack (substitui o navegador na Segtrack quando preenchida)
FULLTRACK_BASE_URL=https://web-service2.ftdata.com.br
FULLTRACK_USERNAME=
FULLTRACK_PASSWORD=
FULLTRACK_CLIENT_ID=
FULLTRACK_API_KEY=
FULLTRACK_SECRET_KEY=

# API Inlog Integration Coleta — Consórcio Aparecida
INLOG_COLETA_TOKEN_URL=https://consorcioaparecida.inlog.com.br/autenticacao-services/connect/token
INLOG_COLETA_BASE_URL=https://consorcioaparecida.inlog.com.br/IntegrationColeta
INLOG_COLETA_CLIENT_ID=
INLOG_COLETA_CLIENT_SECRET=
INLOG_COLETA_GRANT_TYPE=client_credentials
INLOG_COLETA_SCOPE=Inlog.Integration.Coleta.Api

# Chatbot WhatsApp (WuzAPI). O painel não mostra o endereço do servidor.
# Token e QR são gerados no painel (Chatbot WhatsApp).
WUZAPI_URL=
WUZAPI_ADMIN_TOKEN=
WUZAPI_TOKEN=
CHATBOT_GRUPO_JID=
HOST=127.0.0.1
