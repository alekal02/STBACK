FULLTRACK_BASE_URL=https://web-service2.ftdata.com.br
FULLTRACK_USERNAME=
FULLTRACK_PASSWORD=
FULLTRACK_CLIENT_ID=
FULLTRACK_API_KEY=
FULLTRACK_SECRET_KEY=
# Vazio = placas da coleta que já existem na Sagtrack e tiveram pulso em Aparecida.
SAGTRACK_VEICULOS=
PORTA=6480
# Turno da coleta: 06:00 de um dia até 05:59 do dia seguinte.
HORA_INICIO=06:00
HORA_FIM=05:59
# Wuzapi que está no ar no Docker (sistemma-wuzapi, porta 8080).
# A Sagtrack usa um usuário próprio para não trocar o webhook do Sistemma.
WUZAPI_URL=http://127.0.0.1:8080
WUZAPI_TOKEN=
WUZAPI_ADMIN_TOKEN=
WEBHOOK_URL=http://host.docker.internal:6480/api/webhooks/whatsapp
WHATSAPP_GROUP_JID=
WHATSAPP_ALLOWED_JIDS=
